      "edges": [
        { "from": "release", "to": "old-rs", "kind": "control" },
        { "from": "release", "to": "new-rs", "kind": "control" },
        { "from": "old-rs", "to": "old-pod", "kind": "control" },
        { "from": "new-rs", "to": "new-pod", "kind": "control" },
        { "from": "old-pod", "to": "service", "kind": "data" },
        { "from": "new-pod", "to": "service", "kind": "data" }
      ]
    },
    "failure": {
      "nodes": [
        { "id": "client", "name": "Cliente", "subtitle": "Solicitudes", "x": 0.07, "y": 0.5, "kind": "external", "rps": 4 },
        { "id": "service", "name": "Service", "subtitle": "Endpoints disponibles", "x": 0.3, "y": 0.5, "kind": "network" },
        { "id": "pod1", "name": "Pod frontend 1", "subtitle": "Puede fallar", "x": 0.55, "y": 0.25, "kind": "workload", "killable": true },
        { "id": "pod2", "name": "Pod frontend 2", "subtitle": "Réplica", "x": 0.55, "y": 0.75, "kind": "workload" },
        { "id": "node1", "name": "Nodo worker 1", "subtitle": "Ejecuta Pod 1", "x": 0.78, "y": 0.25, "kind": "compute", "killable": true },
        { "id": "node2", "name": "Nodo worker 2", "subtitle": "Ejecuta Pod 2", "x": 0.78, "y": 0.75, "kind": "compute" },
        { "id": "controller", "name": "Controller", "subtitle": "Reconciliación", "x": 0.3, "y": 0.15, "kind": "control-plane" },
        { "id": "registry", "name": "Registry de imágenes", "subtitle": "Pull de contenedores", "x": 0.3, "y": 0.85, "kind": "storage", "killable": true },
        { "id": "readiness", "name": "Readiness probe", "subtitle": "Estado de servicio", "x": 0.55, "y": 0.5, "kind": "control-plane", "killable": true }
      ],
      "edges": [
        { "from": "client", "to": "service", "kind": "data" },
        { "from": "service", "to": "pod1", "kind": "data" },
        { "from": "service", "to": "pod2", "kind": "data" },
        { "from": "pod1", "to": "node1", "kind": "dependency" },
        { "from": "pod2", "to": "node2", "kind": "dependency" },
        { "from": "controller", "to": "pod1", "kind": "control" },
        { "from": "controller", "to": "pod2", "kind": "control" },
        { "from": "registry", "to": "pod1", "kind": "dependency" },
        { "from": "readiness", "to": "service", "kind": "control" }
      ]
    }
  }
}
