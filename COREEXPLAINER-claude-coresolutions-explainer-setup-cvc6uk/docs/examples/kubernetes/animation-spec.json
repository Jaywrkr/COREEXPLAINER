        { "id": "node1", "name": "Nodo worker 1", "subtitle": "Recursos / taints", "x": 0.76, "y": 0.25, "kind": "compute", "capacity": 60, "killable": true },
        { "id": "node2", "name": "Nodo worker 2", "subtitle": "Recursos / afinidad", "x": 0.76, "y": 0.75, "kind": "compute", "capacity": 60 },
        { "id": "constraints", "name": "Restricciones", "subtitle": "Requests y placement", "x": 0.42, "y": 0.15, "kind": "control-plane" }
