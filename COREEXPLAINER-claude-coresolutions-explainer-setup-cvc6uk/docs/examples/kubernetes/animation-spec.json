        { "id": "controller", "name": "Controller Manager", "subtitle": "Reconciliación", "x": 0.6, "y": 0.2, "kind": "control-plane" },
        { "id": "pod1", "name": "Pod frontend 1", "subtitle": "Estado observado", "x": 0.82, "y": 0.3, "kind": "workload" },
        { "id": "pod2", "name": "Pod frontend 2", "subtitle": "Estado observado", "x": 0.82, "y": 0.7, "kind": "workload" },
        { "id": "node", "name": "Nodo worker", "subtitle": "Ejecuta Pods", "x": 0.6, "y": 0.82, "kind": "compute" }
      ],
      "edges": [
        { "from": "developer", "to": "api", "kind": "control" },
        { "from": "api", "to": "controller", "kind": "control" },
