        { "id": "client", "name": "Cliente", "subtitle": "Solicitud", "x": 0.08, "y": 0.5, "kind": "external", "rps": 4 },
        { "id": "service", "name": "Service", "subtitle": "Punto estable", "x": 0.32, "y": 0.5, "kind": "network", "capacity": 100 },
        { "id": "endpoints", "name": "Endpoints", "subtitle": "Selección por labels", "x": 0.54, "y": 0.5, "kind": "control-plane" },
        { "id": "pod1", "name": "Pod listo 1", "subtitle": "Readiness OK", "x": 0.78, "y": 0.25, "kind": "workload", "capacity": 40 },
        { "id": "pod2", "name": "Pod listo 2", "subtitle": "Readiness OK", "x": 0.78, "y": 0.75, "kind": "workload", "capacity": 40 },
        { "id": "readiness", "name": "Readiness probe", "subtitle": "Incluye o retira endpoints", "x": 0.54, "y": 0.15, "kind": "control-plane" }
      ],
      "edges": [
        { "from": "client", "to": "service", "kind": "data" },
        { "from": "service", "to": "endpoints", "kind": "control" },
        { "from": "endpoints", "to": "pod1", "kind": "data" },
        { "from": "endpoints", "to": "pod2", "kind": "data" },
        { "from": "readiness", "to": "endpoints", "kind": "control" }
      ]
    },
    "rollout": {
      "nodes": [
        { "id": "release", "name": "Deployment", "subtitle": "Desired replicas + imagen", "x": 0.12, "y": 0.5, "kind": "control-plane" },
        { "id": "old-rs", "name": "ReplicaSet anterior", "subtitle": "Versión N", "x": 0.4, "y": 0.25, "kind": "control-plane" },
        { "id": "new-rs", "name": "ReplicaSet nuevo", "subtitle": "Versión N+1", "x": 0.4, "y": 0.75, "kind": "control-plane" },
        { "id": "old-pod", "name": "Pods anteriores", "subtitle": "Reduciendo gradualmente", "x": 0.72, "y": 0.25, "kind": "workload", "capacity": 40 },
        { "id": "new-pod", "name": "Pods nuevos", "subtitle": "Readiness requerida", "x": 0.72, "y": 0.75, "kind": "workload", "capacity": 40 },
        { "id": "service", "name": "Service", "subtitle": "Tráfico durante transición", "x": 0.94, "y": 0.5, "kind": "network" }
